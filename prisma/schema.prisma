generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String           @id @default(cuid())
  name            String
  username        String           @unique
  email           String?          @unique
  phone           String?          @unique
  password        String
  createdAt       DateTime         @default(now())
  profile         Profile?
  careerMatches   CareerMatch[]
  skillGapReports SkillGapReport[]
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  dateOfBirth      DateTime?
  nid              String?  @unique
  phone            String?
  district         String?
  skills           String[]
  softSkills       String[]
  budget           String?
  preferredRegions String[]
  timeline         String?
  familyStatus     String?
  workExperiences  WorkExperience[]
  educationEntries EducationEntry[]
  languages        LanguageEntry[]
  updatedAt        DateTime @updatedAt
}

model WorkExperience {
  id               String    @id @default(cuid())
  profileId        String
  profile          Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobTitle         String
  industry         String
  employer         String?
  years            Int?
  currentlyWorking Boolean   @default(false)
  startDate        DateTime?
  endDate          DateTime?
  description      String?
  order            Int       @default(0)

  @@index([profileId])
}

model EducationEntry {
  id          String  @id @default(cuid())
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  level       String
  field       String?
  institution String?
  passingYear Int?
  result      String?
  order       Int     @default(0)

  @@index([profileId])
}

model LanguageEntry {
  id          String  @id @default(cuid())
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  proficiency String
  order       Int     @default(0)

  @@index([profileId])
}

model CareerMatch {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestedCountries  Json
  suggestedJobs       Json
  missingRequirements Json
  createdAt           DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model SkillGapReport {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetJob     String
  targetCountry String
  missingSkills Json
  createdAt     DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}
